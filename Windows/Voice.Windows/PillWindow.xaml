<Window x:Class="Voice.Windows.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice status" Width="246" Height="66" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" IsHitTestVisible="False" UseLayoutRounding="True">
  <Border Background="#EE172923" CornerRadius="25" BorderBrush="#486259" BorderThickness="1" Margin="4" Padding="18,10">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="35" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="28" HorizontalAlignment="Left">
        <Border x:Name="Wave1" Width="3" Height="6" CornerRadius="1.5" Background="#91D4BD" Margin="0,0,3,0" VerticalAlignment="Center" />
        <Border x:Name="Wave2" Width="3" Height="10" CornerRadius="1.5" Background="#91D4BD" Margin="0,0,3,0" VerticalAlignment="Center" />
        <Border x:Name="Wave3" Width="3" Height="18" CornerRadius="1.5" Background="#D1F1E5" Margin="0,0,3,0" VerticalAlignment="Center" />
        <Border x:Name="Wave4" Width="3" Height="10" CornerRadius="1.5" Background="#91D4BD" Margin="0,0,3,0" VerticalAlignment="Center" />
        <Border x:Name="Wave5" Width="3" Height="6" CornerRadius="1.5" Background="#91D4BD" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
        <TextBlock x:Name="StateLabel" Text="Listening" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="DetailLabel" Foreground="#B9CFC5" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
