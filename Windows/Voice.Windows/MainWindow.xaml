<Window x:Class="Voice.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice" Width="1280" Height="850" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,26,16,18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,0,32">
          <Viewbox Width="32" Height="40" Margin="0,0,12,0">
            <Canvas Width="32" Height="40">
              <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 3,15 L 3,25 M 9,8 L 9,32 M 16,2 L 16,38 M 23,10 L 23,30 M 29,15 L 29,25" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="Voice" FontSize="31" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16" Margin="0,18,0,24">
            <StackPanel>
              <TextBlock Text="On your PC" FontWeight="SemiBold" Margin="0,0,0,7" />
              <TextBlock Text="Your voice. Your space." Style="{StaticResource MutedText}" FontSize="12" />
              <TextBlock Text="Audio is processed locally." Style="{StaticResource MutedText}" FontSize="12" />
            </StackPanel>
          </Border>
          <TextBlock Text="Windows preview · 0.7.0" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>
        <ListBox SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Sections">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="14,13" /><Setter Property="Margin" Value="0,4" />
              <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="NavBorder" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SubtleBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="NavBorder" Property="BorderThickness" Value="1" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Setter.Value></Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Margin="0,1,14,0" /><TextBlock Text="Dictation" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" Margin="0,1,14,0" /><TextBlock Text="Notetaker" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" Margin="0,1,14,0" /><TextBlock Text="Dictionary" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,1,14,0" /><TextBlock Text="History" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,1,14,0" /><TextBlock Text="Settings" /></StackPanel></ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="26,20,26,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource Card}" Background="{StaticResource AccentSoftBrush}" Padding="18,14" Visibility="{Binding HasMeetingPrompt, Converter={StaticResource BoolVisibility}}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="Meeting detected" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding MeetingPromptText}" Style="{StaticResource MutedText}" /></StackPanel>
          <Button Grid.Column="1" Content="Start notetaker" Style="{StaticResource PrimaryButton}" Command="{Binding AcceptMeetingPromptCommand}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Not now" Command="{Binding DismissMeetingPromptCommand}" VerticalAlignment="Center" Margin="0" />
        </Grid>
      </Border>

      <!-- Dictation -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSectionIndex}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel Margin="0,8,10,10">
          <TextBlock Text="Dictation" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Speak naturally. Keep your words on your PC." Style="{StaticResource MutedText}" Margin="0,0,0,28" />
          <Border Style="{StaticResource Card}" Padding="30">
            <StackPanel>
              <TextBlock Text="A little less typing." FontFamily="Georgia" FontSize="34" Margin="0,0,0,15" />
              <TextBlock Text="Click in a text field, then press the shortcut to start. Press it again when you finish speaking." Style="{StaticResource MutedText}" Margin="0,0,0,22" />
              <Border Background="{StaticResource SubtleBrush}" CornerRadius="9" Padding="18,11" HorizontalAlignment="Left" Margin="0,0,0,24"><TextBlock Text="Ctrl  +  Alt  +  Space" FontSize="17" FontWeight="SemiBold" /></Border>
              <WrapPanel>
                <Button Content="{Binding DictationButtonText, FallbackValue=Start dictation}" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleDictationCommand}" MinWidth="150" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
              </WrapPanel>
              <TextBlock Text="Use the shortcut while your destination app is focused. Button-started dictation is also kept in History so you can copy it." Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Make it sound like you" Style="{StaticResource SectionTitle}" />
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="Dictation mode" FontWeight="SemiBold" /><TextBlock Text="Fast transcribes directly. Clean adds a local editing step for punctuation and corrections." Style="{StaticResource MutedText}" FontSize="13" Margin="0,5,0,0" /></StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" VerticalAlignment="Top" AutomationProperties.Name="Dictation mode"><ComboBoxItem Content="Fast" /><ComboBoxItem Content="Clean" /></ComboBox>
              </Grid>
              <CheckBox Content="Mute PC audio while dictating" IsChecked="{Binding MuteDuringDictation, Mode=TwoWay}" />
              <TextBlock Text="Your previous mute state is restored when dictation ends. Meeting audio is kept on." Style="{StaticResource MutedText}" FontSize="12" />
            </StackPanel>
          </Border>
          <TextBlock Text="First time? Download the speech model in Settings. Clean mode also needs the optional editing model." Style="{StaticResource MutedText}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Meeting workspace -->
      <Grid Grid.Row="1" Margin="0,8,0,8">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSectionIndex}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Notetaker" Style="{StaticResource PageTitle}" /><TextBlock Text="The conversation, with room for your own thoughts." Style="{StaticResource MutedText}" /></StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Start meeting" Style="{StaticResource PrimaryButton}" Command="{Binding StartMeetingCommand}" /><Button Content="Stop" Command="{Binding StopMeetingCommand}" Margin="0" /></WrapPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,8" Margin="0,22,0,18">
          <WrapPanel><CheckBox Content="Online meeting (microphone + PC audio)" IsChecked="{Binding MeetingOnlineMode, Mode=TwoWay}" Margin="0,8,24,8" /><CheckBox Content="Suggest meeting notes" IsChecked="{Binding SuggestMeetings, Mode=TwoWay}" Margin="0,8,24,8" /><CheckBox Content="Identify speakers" IsChecked="{Binding AnalyzeSpeakers, Mode=TwoWay}" Margin="0,8,24,8" /><CheckBox Content="Create summary" IsChecked="{Binding GenerateSummary, Mode=TwoWay}" Margin="0,8,0,8" /></WrapPanel>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="215" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="9">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="PAST MEETINGS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="10,10,0,15" />
              <Grid>
                <ListBox ItemsSource="{Binding Meetings}" SelectedItem="{Binding SelectedMeeting, Mode=TwoWay}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved meetings">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="MeetingBorder" CornerRadius="8" Padding="11,13" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="MeetingBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MeetingBorder" Property="Background" Value="{StaticResource SubtleBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxHeight="60" /><TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No meetings yet.&#10;&#10;Start a meeting to keep its transcript and notes here." FontSize="13" Margin="13,20" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Meetings.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
            <Grid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="310">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedMeeting}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="A place for the whole conversation" FontFamily="Georgia" FontSize="27" TextAlignment="Center" Margin="0,0,0,15" />
                <TextBlock Text="Select a saved meeting, or start one above. Recording only begins when you choose Start." Style="{StaticResource MutedText}" TextAlignment="Center" />
              </StackPanel>
              <Grid>
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding SelectedMeeting}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="{Binding SelectedMeeting.Title}" FontFamily="Georgia" FontSize="27" Margin="0,0,0,10" /><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedMeeting.DateText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,18,0" /><TextBlock Text="{Binding SelectedMeeting.DurationText}" Style="{StaticResource MutedText}" FontSize="12" /></StackPanel></StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,17,0,18"><Button Content="Copy" Command="{Binding CopyMeetingCommand}" Padding="13,7" MinHeight="34" /><Button Content="Export" Command="{Binding ExportMeetingCommand}" Padding="13,7" MinHeight="34" /><Button Content="Retry analysis" Command="{Binding RetryMeetingCommand}" Padding="13,7" MinHeight="34" /></WrapPanel>
                <TabControl Grid.Row="2">
                  <TabItem Header="My notes"><TextBox Text="{Binding SelectedMeeting.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditMeeting}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="Transparent" FontSize="15" BorderThickness="0" Padding="0,5" AutomationProperties.Name="Personal meeting notes" /></TabItem>
                  <TabItem Header="Transcript">
                    <DockPanel>
                      <Expander DockPanel.Dock="Bottom" Header="Speaker names" Margin="0,12,0,0">
                        <StackPanel Margin="0,10,0,0"><TextBlock Text="One name per line, for example: Speaker 1 = Sunday" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,7" /><TextBox Text="{Binding SpeakerNamesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditMeeting}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" MinHeight="55" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Speaker names" /><Button Content="Save speaker names" Command="{Binding SaveSpeakerNamesCommand}" HorizontalAlignment="Left" Margin="0,9,0,0" Padding="13,7" MinHeight="34" /></StackPanel>
                      </Expander>
                      <TextBox Text="{Binding SelectedMeeting.Transcript, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="Transparent" FontSize="15" BorderThickness="0" Padding="0,5" AutomationProperties.Name="Meeting transcript" />
                    </DockPanel>
                  </TabItem>
                  <TabItem Header="Summary"><TextBox Text="{Binding SelectedMeeting.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditMeeting}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="Transparent" FontSize="15" BorderThickness="0" Padding="0,5" AutomationProperties.Name="Meeting summary" /></TabItem>
                </TabControl>
                <Grid Grid.Row="3" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Saved on this PC" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Save notes" Command="{Binding SaveMeetingCommand}" Margin="0" Padding="14,8" MinHeight="36" /></Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- Dictionary -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSectionIndex}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel Margin="0,8,10,10">
          <TextBlock Text="Dictionary" Style="{StaticResource PageTitle}" />
          <TextBlock Text="A little context for the words you use every day." Style="{StaticResource MutedText}" Margin="0,0,0,28" />
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Names and preferred spellings" Style="{StaticResource SectionTitle}" /><TextBlock Text="Add one name, brand or specialist term per line. These suggestions help recognition; they cannot guarantee every spelling." Style="{StaticResource MutedText}" Margin="0,0,0,17" /><TextBox Text="{Binding DictionaryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="270" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Preferred words and names" /><Button Content="Save dictionary" Style="{StaticResource PrimaryButton}" Command="{Binding SaveDictionaryCommand}" HorizontalAlignment="Left" Margin="0,18,0,0" /></StackPanel></Border>
          <TextBlock Text="Your dictionary stays on this PC." Style="{StaticResource MutedText}" />
        </StackPanel>
      </ScrollViewer>

      <!-- History -->
      <Grid Grid.Row="1" Margin="0,8,0,8">
        <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSectionIndex}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,25"><TextBlock Text="History" Style="{StaticResource PageTitle}" /><TextBlock Text="Your recent dictations, ready to copy again." Style="{StaticResource MutedText}" /></StackPanel>
        <Grid Grid.Row="1">
          <ListBox ItemsSource="{Binding History}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Dictation history">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="20"><StackPanel><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Copy" Command="{Binding DataContext.CopyHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Text}" Padding="13,6" MinHeight="32" Margin="0" /><TextBlock Text="{Binding DateText}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" /></DockPanel><TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" FontSize="15" MaxHeight="190" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Dictated text" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="Your words will appear here" FontFamily="Georgia" FontSize="30" TextAlignment="Center" Margin="0,0,0,14" /><TextBlock Text="Finish your first dictation to keep a copy here, even when pasting into another app is unavailable." Style="{StaticResource MutedText}" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Settings -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedSectionIndex}" Value="4"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel Margin="0,8,10,10">
          <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Set up once. Then just speak." Style="{StaticResource MutedText}" Margin="0,0,0,28" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Local models" Style="{StaticResource SectionTitle}" /><TextBlock Text="Models download from their published sources and are verified before use. Once downloaded, processing works offline." Style="{StaticResource MutedText}" Margin="0,0,0,20" />
              <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Speech recognition" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding SpeechModelOptions}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSpeechModelId, Mode=TwoWay}" Margin="0,10,0,7" AutomationProperties.Name="Speech model" /><TextBlock Text="Turbo balances accuracy and speed. Base English is smaller and faster; Large needs more memory and processing time." Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,6" /><TextBlock Text="{Binding SpeechStatus}" FontSize="12" Foreground="{StaticResource AccentBrush}" /></StackPanel><Button Grid.Column="1" Content="Download speech" Command="{Binding DownloadSpeechCommand}" Margin="0" VerticalAlignment="Center" /></Grid>
              <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,18" />
              <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Editing and summaries" FontWeight="SemiBold" /><TextBlock Text="Qwen 2.5 7B · about 4.7 GB · optional" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,2" /><TextBlock Text="Needed for Clean mode and meeting summaries. CPU processing can take time." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,2" /><TextBlock Text="{Binding EditorStatus}" FontSize="12" Foreground="{StaticResource AccentBrush}" /></StackPanel><Button Grid.Column="1" Content="Download editor" Command="{Binding DownloadEditorCommand}" Margin="0" VerticalAlignment="Center" /></Grid>
              <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,18" />
              <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Speaker analysis" FontWeight="SemiBold" /><TextBlock Text="Local segmentation and voice embeddings · about 65 MB installed" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,2" /><TextBlock Text="Speaker labels are estimates. You can rename them in a meeting." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,2" /><TextBlock Text="{Binding SpeakerStatus}" FontSize="12" Foreground="{StaticResource AccentBrush}" /></StackPanel><Button Grid.Column="1" Content="Download speakers" Command="{Binding DownloadSpeakerCommand}" Margin="0" VerticalAlignment="Center" /></Grid>
              <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="5" Foreground="{StaticResource AccentBrush}" Background="{StaticResource SubtleBrush}" BorderThickness="0" AutomationProperties.Name="Model download progress" />
              <TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" />
              <Button Content="Cancel current task" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="13,7" MinHeight="34" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Meetings and privacy" Style="{StaticResource SectionTitle}" /><CheckBox Content="Keep meeting audio for playback and retry" IsChecked="{Binding KeepAudio, Mode=TwoWay}" /><TextBlock Text="If analysis fails, audio is retained so you can retry. Audio and notes are saved on this PC. Online meetings capture PC output, so close unrelated audio and use headphones." Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,16" /><WrapPanel><Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" /><Button Content="Microphone settings" Command="{Binding OpenMicrophoneSettingsCommand}" /></WrapPanel></StackPanel></Border>
          <TextBlock Text="Voice for Windows · 0.7.0 preview · Intel/AMD 64-bit&#10;No cloud processing, account or API key. Closing Voice stops recording and releases the shortcut." Style="{StaticResource MutedText}" FontSize="12" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,6,10,0" VerticalAlignment="Top" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding StatusText, FallbackValue=Starting Voice…}" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
